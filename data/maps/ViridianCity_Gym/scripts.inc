	goto_if_unset FLAG_GIO_MEM_CH3_ESCORT_CHECKPOINT_2, ViridianCity_Gym_EventScript_GiovanniMemoryObjectivesIncomplete
	goto_if_unset FLAG_GIO_MEM_CH3_FINAL_TUNNEL_DEFENSE_BATTLE_WON, ViridianCity_Gym_EventScript_MemoryFinalDefenseEncounter
	setflag FLAG_ROCKET_DISBANDED
	fadescreen FADE_TO_BLACK
	warp MAP_VIRIDIAN_CITY_GYM, 17, 20
	waitstate
	call ViridianCity_Gym_EventScript_MemoryChapterCompleteChain
	special RestoreGiovanniMemoryModeSnapshot
	special ClearGiovanniMemoryModeCaptureLock
	fadescreen FADE_FROM_BLACK
	call ViridianCity_Gym_EventScript_GiovanniMemoryClosingMonologue
	msgbox ViridianCity_Gym_Text_MemoryAct5PresentResume, MSGBOX_AUTOCLOSE
	special ReconcileGiovanniMemoryModeOutcome
	special SyncGiovanniMemoryModeNpcState
	goto ViridianCity_Gym_EventScript_GiovanniStartBattle
