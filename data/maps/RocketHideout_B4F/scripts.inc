RocketHideout_B4F_EventScript_MemoryExitGuard::
	setvar VAR_0x8004, 1
	call EventScript_GiovanniSharedWarp_ResolvePrecedence
	goto_if_eq VAR_RESULT, GIO_SHARED_WARP_RESULT_NORMAL_ROUTE, EventScript_Nothing
	goto_if_eq VAR_RESULT, GIO_SHARED_WARP_RESULT_LOCKED_FALLBACK, RocketHideout_B4F_EventScript_MemoryDesyncReturnToHub
	goto_if_lt VAR_ROCKETOPS_CH1_STAGE, 2, RocketHideout_B4F_EventScript_MemoryExitGuard_ReturnEntry
	goto_if_lt VAR_ROCKETOPS_CH1_STAGE, 3, RocketHideout_B4F_EventScript_MemoryExitGuard_ReturnFork
	lockall
	msgbox RocketHideout_B4F_Text_MemoryExitBlocked
	warp MAP_ROCKET_HIDEOUT_B4F, 19, 6
	waitstate
	releaseall
	end

RocketHideout_B4F_EventScript_MemoryExitGuard_ReturnEntry::
	lockall
	msgbox RocketHideout_B4F_Text_MemoryExitBlocked
	warp MAP_ROCKET_HIDEOUT_B4F, 19, 6
	waitstate
	releaseall
	end

RocketHideout_B4F_EventScript_MemoryExitGuard_ReturnFork::
	lockall
	msgbox RocketHideout_B4F_Text_MemoryExitBlocked
	warp MAP_ROCKET_HIDEOUT_B4F, 18, 12
	waitstate
	releaseall
	end

RocketHideout_B4F_EventScript_MemoryExitGuard_Mismatch::
	lockall
	msgbox RocketHideout_B4F_Text_MemoryChapterMismatch
	warp MAP_ROCKET_HIDEOUT_B4F, 19, 6
	waitstate
	releaseall
	end

	@ Act endpoint command matrix (C1):
	@   Act1 -> allow Secure Route; forbid Deploy Agent, Destroy Data, Extract Staff.
	@   Act2 -> allow Deploy Agent; forbid Secure Route, Destroy Data, Extract Staff.
	@   Act3 -> allow Extract Staff; forbid Secure Route, Deploy Agent, Destroy Data.
	@   Act4 -> forbid all commands.
RocketHideout_B4F_EventScript_ActEndpoint_Primary::
	goto_if_unset FLAG_SYS_GIOVANNI_MEMORY_MODE_ACTIVE, EventScript_Nothing
	goto_if_ne VAR_CHAPTER_ID, 1, RocketHideout_B4F_EventScript_MemoryDesyncReturnToHub
	goto_if_ge VAR_ROCKETOPS_CH1_STAGE, 3, RocketHideout_B4F_EventScript_ActEndpoint_ReturnHub
	warp MAP_ROCKET_HIDEOUT_B4F, 19, 6
	waitstate
	end

RocketHideout_B4F_EventScript_ActEndpoint_Fallback::
	goto_if_unset FLAG_SYS_GIOVANNI_MEMORY_MODE_ACTIVE, EventScript_Nothing
	goto_if_ne VAR_CHAPTER_ID, 1, RocketHideout_B4F_EventScript_MemoryDesyncReturnToHub
	goto_if_ge VAR_ROCKETOPS_CH1_STAGE, 3, RocketHideout_B4F_EventScript_ActEndpoint_ReturnHub
	end

RocketHideout_B4F_EventScript_ActEndpoint_ReturnHub::
	lockall
	warp MAP_ROCKET_HIDEOUT_B4F, 19, 6
	waitstate
	releaseall
	end
