ViridianCity_House_Text_NicknamingIsFun::
    .string "Coming up with nicknames is fun,\n"
    .string "but it's not so easy to do.\p"
    .string "Clever names are nice, but simple\n"
    .string "names are easier to remember.$"

ViridianCity_House_Text_MyDaddyLovesMonsToo::
    .string "My daddy loves POKéMON, too.$"

ViridianCity_House_Text_Speary::
    .string "SPEARY: Tetweet!$"

ViridianCity_House_Text_SpearowNameSpeary::
    .string "SPEAROW\n"
    .string "Name: SPEARY$"


ViridianCity_House_Text_RecurringRoster_Act1::
    .string "I heard Rocket names on the scanner—\n"
    .string "OPS OFFICER VERA, ENGINEER ROURKE,\n"
    .string "DR. NOX, CAPTAIN DRAKE.$"

ViridianCity_House_Text_RecurringRoster_Act2::
    .string "VERA is loading evac vans. ROURKE keeps\n"
    .string "arguing with command. DRAKE still sounds\n"
    .string "like he's ready to hold the line.$"

ViridianCity_House_Text_RecurringRoster_Act3::
    .string "No fresh ping from DR. NOX. The others are\n"
    .string "still active on channel seven, but they\n"
    .string "don't sound like one team anymore.$"

ViridianCity_House_Text_RecurringRoster_Resolved::
    .string "Final status: VERA evacuated civilians.\n"
    .string "ROURKE walked away disillusioned. DRAKE\n"
    .string "stayed loyal. DR. NOX is still missing.$"
