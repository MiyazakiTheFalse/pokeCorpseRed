SilphCo_11F_MapScripts::
	map_script MAP_SCRIPT_ON_LOAD, SilphCo_11F_OnLoad
	map_script MAP_SCRIPT_ON_TRANSITION, SilphCo_11F_OnTransition
	.byte 0

SilphCo_11F_OnTransition::
	specialvar VAR_RESULT, ValidateGiovanniInteractionOverlayForCurrentMap
	goto_if_eq VAR_RESULT, FALSE, EventScript_Return
	goto_if_unset FLAG_SYS_GIOVANNI_MEMORY_MODE_ACTIVE, SilphCo_11F_EventScript_SkipMemoryRoutingCheck
	goto_if_unset FLAG_SYS_GIOVANNI_MEMORY_MODE_ACTIVE, SilphCo_11F_EventScript_MemoryDesyncReturnToHub
	goto_if_ne VAR_GIO_CHAPTER, 2, SilphCo_11F_EventScript_MemoryDesyncReturnToHub
	goto_if_unset FLAG_GIO_MEM_CH1_COMPLETE, SilphCo_11F_EventScript_MemoryDesyncReturnToHub
	goto_if_set FLAG_GIO_MEM_CH2_COMPLETE, SilphCo_11F_EventScript_MemoryDesyncReturnToHub
	goto_if_set FLAG_GIO_MEM_CH3_COMPLETE, SilphCo_11F_EventScript_MemoryDesyncReturnToHub
	goto SilphCo_11F_EventScript_ChapterHubEntry

SilphCo_11F_EventScript_SkipMemoryRoutingCheck::
	end

SilphCo_11F_EventScript_MemoryDesyncReturnToHub::
	warp MAP_SILPH_CO_11F, 6, 14
	waitstate
	end

SilphCo_11F_EventScript_ChapterHubEntry::
	specialvar VAR_RESULT, Special_GiovanniCampaignDispatch
	goto_if_eq VAR_RESULT, 2, SilphCo_11F_EventScript_ChapterHubReturnScene
	goto_if_eq VAR_RESULT, 0, SilphCo_11F_EventScript_ChapterHubDirective
	goto_if_eq VAR_RESULT, 3, SilphCo_11F_EventScript_ChapterHubDirective
	goto_if_eq VAR_RESULT, 4, SilphCo_11F_EventScript_ChapterHubWatchdog
	end

SilphCo_11F_EventScript_ChapterHubReturnScene::
	goto_if_unset FLAG_ROCKETOPS_MILESTONE_CH2_LOGGED, SilphCo_11F_EventScript_ChapterHubReturnScene_MilestoneMissing
	msgbox SilphCo_11F_Text_ChapterReveal_EconomicControl, MSGBOX_AUTOCLOSE
	setvar VAR_GIO_SEGMENT, 6 @ GIO_SEGMENT_7
	end

SilphCo_11F_EventScript_ChapterHubReturnScene_MilestoneMissing::
	msgbox SilphCo_11F_Text_RocketOps_MilestoneLogged_C2, MSGBOX_AUTOCLOSE
	setvar VAR_GIO_SEGMENT, 6 @ GIO_SEGMENT_7
	end

SilphCo_11F_EventScript_ChapterHubDirective::
	call EventScript_GiovanniCampaign_PrintActiveDirective
	setvar VAR_GIO_SEGMENT, 2 @ GIO_SEGMENT_3
	end

SilphCo_11F_EventScript_ChapterHubWatchdog::
	call EventScript_GiovanniCampaign_WatchdogHint
	setvar VAR_GIO_SEGMENT, 2 @ GIO_SEGMENT_3
	end

SilphCo_11F_EventScript_MemorySpaceMarker::
	goto_if_ne VAR_GIO_CHAPTER, 2, SilphCo_11F_EventScript_MemoryChapterMismatchMarker
	goto_if_set FLAG_GIO_MEM_CH2_COMPLETE, SilphCo_11F_EventScript_MemorySpaceMarkerComplete
	setvar VAR_ROCKETOPS_CH2_STAGE, 0
	call EventScript_GiovanniCampaign_PrintActiveDirective
	end

SilphCo_11F_EventScript_MemorySpaceMarkerComplete::
	msgbox SilphCo_11F_Text_MemorySpaceMarker, MSGBOX_AUTOCLOSE
	end

SilphCo_11F_EventScript_MemoryChapterMismatchMarker::
	msgbox SilphCo_11F_Text_MemoryChapterMismatch, MSGBOX_AUTOCLOSE
	end


SilphCo_11F_EventScript_MemoryFieldAide::
	goto EventScript_RocketOps_UseSurveillanceNodeTerminal

SilphCo_11F_EventScript_MemorySecureRouteTerminal::
	goto EventScript_RocketOps_UseControlNodeTerminal

SilphCo_11F_EventScript_MemoryDestroyDataTerminal::
	goto EventScript_RocketOps_UseArchiveNodeTerminal

SilphCo_11F_EventScript_MemoryExtractStaffTerminal::
	goto EventScript_RocketOps_UseExtractionNodeTerminal

EventScript_RocketOps_Command_SecureRoute_C2::
	setvar VAR_GIO_SEGMENT, 3 @ GIO_SEGMENT_4
	setflag FLAG_ROCKETOPS_ORDER_SECURE_CORRIDOR
	setflag FLAG_GIO_MEM_CH2_ROUTE_UNSEALED_VISUAL
	setflag FLAG_SILPH_11F_DOOR
	call EventScript_Open11FDoor
	call SilphCo_11F_EventScript_RunDoorSealingPatrol
	special DrawWholeMapView
	msgbox SilphCo_11F_Text_RocketOps_SecureRoute_C2
	goto EventScript_RocketOps_CommandFinalize

EventScript_RocketOps_Command_DeployAgent_C2::
	setvar VAR_GIO_SEGMENT, 3 @ GIO_SEGMENT_4
	setflag FLAG_ROCKETOPS_ORDER_HOLD_POSITION
	goto_if_set FLAG_GIO_MEM_CH2_ALARM_ESCALATED_VISUAL, EventScript_RocketOps_Command_DeployAgent_C2_SkipAlarmFx
	playse SE_BOO
	setvar VAR_0x8004, 0
	setvar VAR_0x8005, 2
	setvar VAR_0x8006, 3
	setvar VAR_0x8007, 2
	special ShakeScreen
	setflag FLAG_GIO_MEM_CH2_ALARM_ESCALATED_VISUAL
EventScript_RocketOps_Command_DeployAgent_C2_SkipAlarmFx::
	call SilphCo_11F_EventScript_RunScientistConvoyMovement
	removeobject LOCALID_SILPH_CO_11F_GRUNT1
	removeobject LOCALID_SILPH_CO_11F_GRUNT2
	special DrawWholeMapView
	msgbox SilphCo_11F_Text_RocketOps_DeployAgent_C2
	goto EventScript_RocketOps_CommandFinalize

EventScript_RocketOps_Command_DestroyData_C2::
	setvar VAR_GIO_SEGMENT, 3 @ GIO_SEGMENT_4
	setflag FLAG_ROCKETOPS_ORDER_OPEN_ROUTE
	goto_if_set FLAG_GIO_MEM_CH2_SERVER_DESTROYED_VISUAL, EventScript_RocketOps_Command_DestroyData_C2_SkipServerFx
	playse SE_TRUCK_MOVE
	setvar VAR_0x8004, 0
	setvar VAR_0x8005, 3
	setvar VAR_0x8006, 4
	setvar VAR_0x8007, 2
	special ShakeScreen
	setflag FLAG_GIO_MEM_CH2_SERVER_DESTROYED_VISUAL
EventScript_RocketOps_Command_DestroyData_C2_SkipServerFx::
	special DrawWholeMapView
	msgbox SilphCo_11F_Text_RocketOps_DestroyData_C2
	goto EventScript_RocketOps_CommandFinalize

EventScript_RocketOps_Command_ExtractStaff_C2::
	setvar VAR_GIO_SEGMENT, 3 @ GIO_SEGMENT_4
	setflag FLAG_ROCKETOPS_ORDER_HOLD_POSITION
	special DrawWholeMapView
	msgbox SilphCo_11F_Text_RocketOps_ExtractStaff_C2
	goto EventScript_RocketOps_CommandFinalize

SilphCo_11F_OnLoad::
	goto_if_set FLAG_GIO_MEM_CH2_ROUTE_UNSEALED_VISUAL, SilphCo_11F_OnLoad_OpenDoor
	goto_if_set FLAG_ROCKETOPS_ORDER_SECURE_CORRIDOR, SilphCo_11F_OnLoad_OpenDoor
	call_if_unset FLAG_SILPH_11F_DOOR, EventScript_Close11FDoor
	goto SilphCo_11F_OnLoad_End

SilphCo_11F_OnLoad_OpenDoor::
	setflag FLAG_SILPH_11F_DOOR
	call EventScript_Open11FDoor
SilphCo_11F_OnLoad_End::
	end

SilphCo_11F_EventScript_President::
	lock
	faceplayer
	goto_if_set FLAG_GOT_MASTER_BALL_FROM_SILPH, SilphCo_11F_EventScript_AlreadyGotMasterBall
	checkplayergender
	call_if_eq VAR_RESULT, MALE, SilphCo_11F_EventScript_PresidentThanksMale
	call_if_eq VAR_RESULT, FEMALE, SilphCo_11F_EventScript_PresidentThanksFemale
	checkitemspace ITEM_MASTER_BALL
	goto_if_eq VAR_RESULT, FALSE, SilphCo_11F_EventScript_NoRoomForMasterBall
	giveitem_msg SilphCo_11F_Text_ObtainedMasterBallFromPresident, ITEM_MASTER_BALL, 1, MUS_OBTAIN_KEY_ITEM
	msgbox SilphCo_11F_Text_ThatsOurSecretPrototype
	setflag FLAG_GOT_MASTER_BALL_FROM_SILPH
	release
	end

SilphCo_11F_EventScript_PresidentThanksMale::
	msgbox SilphCo_11F_Text_ThanksForSavingMeDearBoy
	return

SilphCo_11F_EventScript_PresidentThanksFemale::
	msgbox SilphCo_11F_Text_ThanksForSavingMeDearGirl
	return

SilphCo_11F_EventScript_NoRoomForMasterBall::
	msgbox SilphCo_11F_Text_YouHaveNoRoomForThis
	release
	end

SilphCo_11F_EventScript_AlreadyGotMasterBall::
	msgbox SilphCo_11F_Text_ThatsOurSecretPrototype
	release
	end

SilphCo_11F_EventScript_Secretary::
	msgbox SilphCo_11F_Text_ThanksForRescuingUs, MSGBOX_NPC
	end

SilphCo_11F_EventScript_GiovanniTriggerLeft::
	goto_if_unset FLAG_SYS_GIOVANNI_MEMORY_MODE_ACTIVE, EventScript_Nothing
	lockall
	setvar VAR_TEMP_1, 0
	goto SilphCo_11F_EventScript_BattleGiovanni
	end

SilphCo_11F_EventScript_GiovanniTriggerRight::
	goto_if_unset FLAG_SYS_GIOVANNI_MEMORY_MODE_ACTIVE, EventScript_Nothing
	lockall
	setvar VAR_TEMP_1, 1
	goto SilphCo_11F_EventScript_BattleGiovanni
	end

SilphCo_11F_EventScript_BattleGiovanni::
	textcolor NPC_TEXT_COLOR_MALE
	applymovement LOCALID_SILPH_CO_GIOVANNI, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	delay 25
	msgbox SilphCo_11F_Text_GiovanniIntro
	closemessage
	call_if_eq VAR_TEMP_1, 0, SilphCo_11F_EventScript_GiovanniApproachLeft
	call_if_eq VAR_TEMP_1, 1, SilphCo_11F_EventScript_GiovanniApproachRight
	setvar VAR_LAST_TALKED, LOCALID_SILPH_CO_GIOVANNI
	trainerbattle_no_intro TRAINER_BOSS_GIOVANNI_2, SilphCo_11F_Text_GiovanniDefeat
	msgbox SilphCo_11F_Text_GiovanniPostBattle
	closemessage
	fadescreen FADE_TO_BLACK
	removeobject LOCALID_SILPH_CO_GIOVANNI
	removeobject LOCALID_SILPH_CO_11F_GRUNT1
	removeobject LOCALID_SILPH_CO_11F_GRUNT2
	fadescreen FADE_FROM_BLACK
	setvar VAR_MAP_SCENE_SILPH_CO_11F, 1
	goto_if_set FLAG_SYS_GIOVANNI_MEMORY_MODE_ACTIVE, SilphCo_11F_EventScript_SetMemorySaffronOutcome
	setflag FLAG_HIDE_SAFFRON_ROCKETS
	clearflag FLAG_HIDE_SAFFRON_CIVILIANS
	releaseall
	end

SilphCo_11F_EventScript_SetMemorySaffronOutcome::
	goto_if_unset FLAG_SILPH_INFILTRATION_PREPARED, SilphCo_11F_EventScript_MemoryChapterObjectivesIncomplete
	call_if_set FLAG_SILPH_INFILTRATION_PREPARED, SilphCo_11F_EventScript_RocketOpsMilestoneConfirm
	setvar VAR_GIO_ACT, 1
	setvar VAR_GIO_CHECKPOINT_ID, 0
	special SaveGiovanniMemoryModeCheckpoint
	msgbox SilphCo_11F_Text_MemoryChapter3EmergencyBriefing, MSGBOX_AUTOCLOSE
	msgbox SilphCo_11F_Text_MemoryChapter3ObjectiveInit, MSGBOX_AUTOCLOSE
	msgbox SilphCo_11F_Text_MemoryChapterOutro, MSGBOX_AUTOCLOSE
	closemessage
	specialvar VAR_RESULT, CompleteGiovanniMemoryModeChapter2
	goto_if_eq VAR_RESULT, FALSE, EventScript_Return
	special SyncGiovanniMemoryModeNpcState
	releaseall
	end

SilphCo_11F_EventScript_MemoryChapterObjectivesIncomplete::
	msgbox SilphCo_11F_Text_RocketReport_ObjectivesIncomplete, MSGBOX_AUTOCLOSE
	setvar VAR_MAP_SCENE_SILPH_CO_11F, 0
	addobject LOCALID_SILPH_CO_GIOVANNI
	addobject LOCALID_SILPH_CO_11F_GRUNT1
	addobject LOCALID_SILPH_CO_11F_GRUNT2
	releaseall
	end

SilphCo_11F_EventScript_RocketOpsMilestoneConfirm::
	msgbox SilphCo_11F_Text_RocketOps_MilestoneLogged_C2, MSGBOX_AUTOCLOSE
	return

SilphCo_11F_EventScript_GiovanniApproachLeft::
	applymovement LOCALID_SILPH_CO_GIOVANNI, SilphCo_11F_Movement_GiovanniApproachLeft
	applymovement LOCALID_PLAYER, SilphCo_11F_Movement_PlayerFaceGiovanni
	waitmovement 0
	return

SilphCo_11F_EventScript_GiovanniApproachRight::
	applymovement LOCALID_SILPH_CO_GIOVANNI, SilphCo_11F_Movement_GiovanniApproachRight
	waitmovement 0
	return

SilphCo_11F_Movement_GiovanniApproachLeft::
	walk_down
	walk_down
	walk_down
	walk_down
	walk_in_place_faster_left
	step_end

SilphCo_11F_Movement_GiovanniApproachRight::
	walk_down
	walk_down
	walk_down
	step_end

SilphCo_11F_Movement_PlayerFaceGiovanni::
	delay_16
	delay_16
	delay_16
	delay_8
	delay_4
	walk_in_place_faster_right
	step_end

@ Unused
