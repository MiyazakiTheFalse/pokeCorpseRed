Route11_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, Route11_OnTransition
	.byte 0

Route11_OnTransition::
	specialvar VAR_RESULT, ValidateGiovanniInteractionOverlayForCurrentMap
	goto_if_eq VAR_RESULT, FALSE, EventScript_Return
	call Route11_EventScript_Act2ForcedStart
	goto_if_set FLAG_SYS_GIOVANNI_MEMORY_MODE_ACTIVE, Route11_EventScript_MemoryRoutingCheck
	goto_if_unset FLAG_SYS_GIOVANNI_MEMORY_MODE_ACTIVE, EventScript_Return
	goto Route11_EventScript_MemoryDesyncReturnToHub


Route11_EventScript_Act2ForcedStart::
	goto_if_unset FLAG_SYS_GIOVANNI_MEMORY_MODE_ACTIVE, Route11_EventScript_Act2ForcedStart_Return
	goto_if_ne VAR_GIO_CHAPTER, 1, Route11_EventScript_Act2ForcedStart_Return
	goto_if_ne VAR_GIO_ACT, 2, Route11_EventScript_Act2ForcedStart_Return
	goto_if_ne VAR_GIO_SEGMENT, 2, Route11_EventScript_Act2ForcedStart_Return
	lockall
	setvar VAR_GIO_ACT, 2
	setvar VAR_GIO_ACTIVE_DIRECTIVE_ID, 102
	msgbox Route11_Text_MemoryAct2CollapseIncident, MSGBOX_AUTOCLOSE
	playse SE_M_DIG
	setvar VAR_0x8004, 0
	setvar VAR_0x8005, 3
	setvar VAR_0x8006, 4
	setvar VAR_0x8007, 2
	special ShakeScreen
	setobjectxy LOCALID_ROUTE11_MEMORY_ENGINEER, 5, 8
	setobjectxy LOCALID_ROUTE11_MEMORY_GUARD, 7, 8
	addobject LOCALID_ROUTE11_MEMORY_ENGINEER
	addobject LOCALID_ROUTE11_MEMORY_GUARD
	clearflag FLAG_ROCKETOPS_AGENT_DEPLOYED
	clearflag FLAG_GIO_MEM_CH1_COLLAPSE_CLEARED
	setvar VAR_GIO_CHECKPOINT_ID, 1
	call EventScript_GiovanniCampaign_PrintActiveDirective
	setvar VAR_GIO_SEGMENT, 3 @ GIO_SEGMENT_4; save blocked during active act pressure
	releaseall
Route11_EventScript_Act2ForcedStart_Return::
	return

Route11_EventScript_MemoryRoutingCheck::
	goto_if_unset FLAG_SYS_GIOVANNI_MEMORY_MODE_ACTIVE, Route11_EventScript_MemoryDesyncReturnToHub
	goto_if_eq VAR_GIO_CHAPTER, 1, EventScript_Return
	goto Route11_EventScript_MemoryDesyncReturnToHub

Route11_EventScript_MemoryDesyncReturnToHub::
	warp MAP_ROCKET_HIDEOUT_B4F, 19, 6
	waitstate
	end

Route11_EventScript_DiglettsCaveSign::
	msgbox Route11_Text_DiglettsCave, MSGBOX_SIGN
	end

Route11_EventScript_MemorySupplyCrateRelic::
	goto_if_unset FLAG_SYS_GIOVANNI_MEMORY_MODE_ACTIVE, EventScript_Nothing
	goto_if_ne VAR_GIO_CHAPTER, 1, EventScript_Nothing
	goto_if_set FLAG_GIO_MEM_CH1_DUGTRIO_BOSS_DEFEATED, Route11_EventScript_MemorySupplyCrateRelic_After
	msgbox Route11_Text_MemorySupplyCrateRelic_Before, MSGBOX_SIGN
	end

Route11_EventScript_MemorySupplyCrateRelic_After::
	msgbox Route11_Text_MemorySupplyCrateRelic_After, MSGBOX_SIGN
	end

Route11_EventScript_MemoryTunnelMarkerRelic::
	goto_if_unset FLAG_SYS_GIOVANNI_MEMORY_MODE_ACTIVE, EventScript_Nothing
	goto_if_ne VAR_GIO_CHAPTER, 1, EventScript_Nothing
	goto_if_ne VAR_GIO_ACT, 2, Route11_EventScript_MemoryTunnelMarkerRelic_ReadOnly
	goto_if_set FLAG_GIO_MEM_CH1_COLLAPSE_CLEARED, Route11_EventScript_MemoryTunnelMarkerRelic_ReadOnly
	goto Route11_EventScript_MemoryCollapseControlPanel

Route11_EventScript_MemoryTunnelMarkerRelic_ReadOnly::
	msgbox Route11_Text_MemoryTunnelMarkerRelic, MSGBOX_SIGN
	end

Route11_EventScript_MemoryCollapseControlPanel::
	goto EventScript_RocketOps_UseSurveillanceNodeTerminal

Route11_EventScript_MemoryRouteCheckpoint::
	goto_if_set FLAG_GIO_MEM_CH1_DUGTRIO_BOSS_DEFEATED, Route11_EventScript_MemoryRouteCheckpoint_Save
	lockall
	msgbox Route11_Text_MemoryDiglettSwarmStart, MSGBOX_AUTOCLOSE
	msgbox Route11_Text_MemoryTunnelLeaderPrepLore, MSGBOX_AUTOCLOSE
	trainerbattle_no_intro TRAINER_ROCKETOPS_RANGER_TUNNEL_LEADER, Route11_Text_MemoryTunnelLeaderDefeat
	msgbox Route11_Text_MemoryDiglettSwarmClear, MSGBOX_AUTOCLOSE
	msgbox Route11_Text_MemoryTunnelLeaderAfterLore, MSGBOX_AUTOCLOSE
	playse SE_M_DIG
	setvar VAR_0x8004, 0
	setvar VAR_0x8005, 2
	setvar VAR_0x8006, 3
	setvar VAR_0x8007, 2
	special ShakeScreen
	setflag FLAG_GIO_MEM_CH1_DIGLETT_SWARM_VISUAL
	releaseall

Route11_EventScript_MemoryRouteCheckpoint_Save::
	setvar VAR_0x8004, 1
	call EventScript_GiovanniSharedWarp_ResolvePrecedence
	goto_if_eq VAR_RESULT, GIO_SHARED_WARP_RESULT_NORMAL_ROUTE, EventScript_Nothing
	goto_if_eq VAR_RESULT, GIO_SHARED_WARP_RESULT_LOCKED_FALLBACK, Route11_EventScript_MemoryDesyncReturnToHub
	setflag FLAG_GIO_MEM_CH1_DUGTRIO_BOSS_DEFEATED
	setflag FLAG_GIO_MEM_CH1_DIGLETT_SWARM_VISUAL
	setvar VAR_GIO_ACT, 2
	setvar VAR_GIO_CHECKPOINT_ID, 1
	special SaveGiovanniMemoryModeCheckpoint
	end

Route11_EventScript_MemoryBlockedEngineer::
	msgbox Route11_Text_MemoryBlockedEngineer, MSGBOX_NPC
	end

Route11_EventScript_MemoryBlockedGuard::
	msgbox Route11_Text_MemoryBlockedGuard, MSGBOX_NPC
	end

Route11_Movement_EngineerClearCollapse::
	walk_right
	walk_right
	step_end

Route11_Movement_GuardClearCollapse::
	walk_right
	walk_right
	step_end
