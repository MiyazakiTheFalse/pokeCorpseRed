	goto_if_set FLAG_GIO_NPC_ROURKE_CH2_MILESTONE, SilphCo_10F_EventScript_RecurringEngineerFieldDialogue_Act2
	msgbox SilphCo_10F_Text_RecurringEngineerField_Act1, MSGBOX_AUTOCLOSE
